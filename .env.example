# Retail AI Assistant Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
MODEL_NAME=gpt-4-turbo-preview
TEMPERATURE=0.7
MAX_TOKENS=2048

# Vector Store Configuration
CHROMA_DB_PATH=./chromadb_data
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536

# Database Configuration (Optional)
DATABASE_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Configuration (comma-separated list of allowed origins)
# Default: localhost for development
# Production: Add your actual frontend URL(s) here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting Configuration
# Format: requests/time_period (e.g., "10/minute", "100/hour")
# Protect against DoS and abuse attacks
CHAT_RATE_LIMIT=10/minute
ESCALATION_RATE_LIMIT=30/minute
HEALTH_RATE_LIMIT=100/minute
STATUS_RATE_LIMIT=30/minute

# Authentication Configuration (Security)
# JWT secret key for token signing (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production

# Token expiration time in hours
JWT_EXPIRATION_HOURS=24

# Require authentication on protected endpoints
# Set to "true" in production to enforce authentication
# Set to "false" for development (backward compatibility)
REQUIRE_AUTH=false

# Logging Configuration
LOG_LEVEL=INFO

# Agent Configuration
MAX_ITERATIONS=10
TIMEOUT_SECONDS=30

# Retrieval Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Cache Configuration
ENABLE_CACHE=True
CACHE_TTL_SECONDS=3600

# Feature Flags
ENABLE_ANALYTICS=True
ENABLE_USER_FEEDBACK=True
